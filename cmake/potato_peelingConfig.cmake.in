@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The library's FT type is CGAL's exact rational without GMP's C++ classes; a
# consumer's CGAL must be configured the same way.
if (NOT DEFINED CGAL_WITH_GMPXX)
    set(CGAL_WITH_GMPXX OFF CACHE BOOL "Use GMP's C++ classes in CGAL; must be OFF for potato_peeling")
endif ()
find_dependency(CGAL 5.4)
get_target_property(_potato_peeling_cgal_defs CGAL::CGAL INTERFACE_COMPILE_DEFINITIONS)
if (_potato_peeling_cgal_defs MATCHES "CGAL_USE_GMPXX")
    message(FATAL_ERROR "potato_peeling was built with CGAL_WITH_GMPXX=OFF, but CGAL here uses "
            "GMP's C++ classes, which changes CGAL's exact number type. Configure with "
            "-DCGAL_WITH_GMPXX=OFF (or find potato_peeling before CGAL).")
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/potato_peelingTargets.cmake")
check_required_components(potato_peeling)
